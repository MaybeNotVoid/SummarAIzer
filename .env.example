# ===== WHATSAPP =====
WHATSAPP_SESSION_NAME=summaraizer-session
# Opzionale: lascia vuoto per rilevare automaticamente il tuo numero (client.info.wid)
TARGET_SELF_ID=

# ===== GEMINI API & CATENA DI FALLBACK =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK_1=gemini-4-hydrogen
GEMINI_MODEL_FALLBACK_2=gemini-3.5-flash-lite

# ===== SCHEDULING =====
TIMEZONE=Europe/Rome
MORNING_CRON=15 8 * * *
EVENING_CRON=0 22 * * *
SEND_EMPTY_SUMMARY=true

# ===== GESTIONE "MAPPAZZONE XL" (CHUNKING AUTOMATICO) =====
AUDIO_CHUNK_THRESHOLD_MINUTES=60
CHUNK_COOLDOWN_SECONDS=65

# ===== CATEGORIZZAZIONE LAVORO vs VITA PRIVATA =====
# Descrizione del tuo ruolo lavorativo usata dal modello per classificare le chat
USER_ROLE_DESCRIPTION=sviluppatore software (progetti tecnici, ticket, deploy, bug, riunioni, clienti)
# Tag o sigle usate nei contatti di lavoro salvati in rubrica (es. AZIENDA,CLIENTE)
WORK_CONTACT_KEYWORDS=AZIENDA,CLIENTE
# ID dei gruppi WhatsApp di lavoro separati da virgola (ottienili con: npm run list-chats)
WORK_GROUP_IDS=
# Parole chiave nei nomi dei gruppi da classificare automaticamente come lavoro
WORK_GROUP_KEYWORDS=software,team,dev,lavoro,work

# ===== ARCHIVIAZIONE & CONTESTO =====
INCLUDE_OWN_MESSAGES=true
RETENTION_HOURS=72
